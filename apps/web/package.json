{
  "name": "samtdi-web",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev": "node scripts/prepare-brand-font.mjs && next dev --hostname 127.0.0.1 --port 3100",
    "build": "node scripts/prepare-brand-font.mjs && next build",
    "start": "next start --hostname 127.0.0.1 --port 3100",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --test lib/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "generate:api": "openapi-typescript ../../contracts/openapi.json -o lib/api-types.ts",
    "verify:pilot": "node scripts/verify-pilot.mjs"
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "4.0.0",
    "@atlaskit/pragmatic-drag-and-drop-hitbox": "3.0.0",
    "@mantine/core": "9.8.1",
    "@mantine/hooks": "9.8.1",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "wavesurfer.js": "8.1.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "openapi-typescript": "7.13.0",
    "playwright": "1.65.0",
    "typescript": "~5.9.3"
  }
}
