{
  "openapi": "3.1.0",
  "info": {
    "title": "Samtdi API",
    "version": "1.0.0"
  },
  "paths": {
    "/livez": {
      "get": {
        "responses": {
          "200": {
            "description": "Process alive"
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "responses": {
          "200": {
            "description": "Dependencies ready"
          },
          "503": {
            "description": "Dependency unavailable"
          }
        }
      }
    },
    "/v1/me": {
      "get": {
        "responses": {
          "200": {
            "description": "Current session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "401": {
            "description": "Login required"
          }
        }
      }
    },
    "/v1/projects": {
      "get": {
        "responses": {
          "200": {
            "description": "Member projects",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Project"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "parameters": [],
        "responses": {
          "201": {
            "description": "Project created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Project"
                }
              }
            }
          },
          "default": {
            "description": "Request failed"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "title"
                ],
                "properties": {
                  "title": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/projects/{project}/archive": {
      "patch": {
        "parameters": [
          {
            "name": "project",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Project archive state changed"
          },
          "default": {
            "description": "Request failed"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "archived"
                ],
                "properties": {
                  "archived": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/logout": {
      "post": {
        "parameters": [],
        "responses": {
          "204": {
            "description": "Session removed"
          },
          "default": {
            "description": "Request failed"
          }
        }
      }
    },
    "/v1/projects/{project}/members": {
      "get": {
        "parameters": [
          {
            "name": "project",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Project membership list"
          },
          "default": {
            "description": "Request failed"
          }
        }
      }
    },
    "/v1/projects/{project}/members/{account}": {
      "patch": {
        "parameters": [
          {
            "name": "project",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "account",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Membership role updated"
          },
          "default": {
            "description": "Request failed"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "role"
                ],
                "properties": {
                  "role": {
                    "$ref": "#/components/schemas/Role"
                  }
                }
              }
            }
          }
        }
      },
      "delete": {
        "parameters": [
          {
            "name": "project",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "account",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Member removed"
          },
          "default": {
            "description": "Request failed"
          }
        }
      }
    },
    "/v1/projects/{project}/invitations": {
      "post": {
        "parameters": [
          {
            "name": "project",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Invitation created"
          },
          "default": {
            "description": "Request failed"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "role"
                ],
                "properties": {
                  "email": {
                    "type": "string"
                  },
                  "role": {
                    "$ref": "#/components/schemas/Role"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/projects/{project}/invitations/{invite}": {
      "delete": {
        "parameters": [
          {
            "name": "project",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "invite",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Invitation revoked"
          },
          "default": {
            "description": "Request failed"
          }
        }
      }
    },
    "/v1/projects/{project}/media": {
      "get": {
        "responses": {
          "200": {
            "description": "Media items",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MediaItem"
                  }
                }
              }
            }
          },
          "default": {
            "description": "Request rejected"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "project",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      },
      "post": {
        "responses": {
          "201": {
            "description": "Media item",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MediaItem"
                }
              }
            }
          },
          "default": {
            "description": "Request rejected"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "project",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "title"
                ],
                "properties": {
                  "title": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/projects/{project}/media/{item}": {
      "patch": {
        "responses": {
          "204": {
            "description": "Media archive changed"
          },
          "default": {
            "description": "Request rejected"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "project",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "in": "path",
            "name": "item",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "archived"
                ],
                "properties": {
                  "archived": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/projects/{project}/media/{item}/versions": {
      "get": {
        "responses": {
          "200": {
            "description": "Version list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MediaVersion"
                  }
                }
              }
            }
          },
          "default": {
            "description": "Request rejected"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "project",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "in": "path",
            "name": "item",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      }
    },
    "/v1/projects/{project}/versions/{version}": {
      "get": {
        "responses": {
          "200": {
            "description": "Version state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MediaVersion"
                }
              }
            }
          },
          "default": {
            "description": "Request rejected"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "project",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "in": "path",
            "name": "version",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      }
    },
    "/v1/projects/{project}/media/{item}/uploads": {
      "post": {
        "responses": {
          "201": {
            "description": "Signed temporary upload",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadSession"
                }
              }
            }
          },
          "default": {
            "description": "Request rejected"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "project",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "in": "path",
            "name": "item",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "filename",
                  "bytes"
                ],
                "properties": {
                  "filename": {
                    "type": "string"
                  },
                  "bytes": {
                    "type": "integer"
                  },
                  "description": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/projects/{project}/uploads/{upload}/complete": {
      "post": {
        "responses": {
          "202": {
            "description": "Registered version",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MediaVersion"
                }
              }
            }
          },
          "default": {
            "description": "Request rejected"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "project",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "in": "path",
            "name": "upload",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 128
            }
          }
        ]
      }
    },
    "/v1/projects/{project}/versions/{version}/files/{asset}": {
      "get": {
        "responses": {
          "200": {
            "description": "Authorized audio or waveform bytes"
          },
          "default": {
            "description": "Request rejected"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "project",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "in": "path",
            "name": "version",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "in": "path",
            "name": "asset",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      }
    },
    "/v1/projects/{project}/versions/{version}/retry": {
      "post": {
        "responses": {
          "202": {
            "description": "Queued retry",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MediaVersion"
                }
              }
            }
          },
          "default": {
            "description": "Request rejected"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "project",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "in": "path",
            "name": "version",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "Role": {
        "type": "string",
        "enum": [
          "owner",
          "editor",
          "reviewer"
        ]
      },
      "Session": {
        "type": "object",
        "required": [
          "account_id",
          "email",
          "kind"
        ],
        "properties": {
          "account_id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          }
        }
      },
      "Project": {
        "type": "object",
        "required": [
          "id",
          "title",
          "role"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "archived_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "MediaItem": {
        "type": "object",
        "required": [
          "id",
          "title"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "archived_at": {
            "type": "string"
          }
        }
      },
      "MediaVersion": {
        "type": "object",
        "required": [
          "id",
          "item_id",
          "filename",
          "description",
          "state",
          "created_at"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "item_id": {
            "type": "string"
          },
          "filename": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "queued",
              "processing",
              "ready",
              "failed"
            ]
          },
          "duration_ms": {
            "type": "integer"
          },
          "failure": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          }
        }
      },
      "UploadSession": {
        "type": "object",
        "required": [
          "id",
          "url",
          "expires_at",
          "headers"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "expires_at": {
            "type": "string"
          },
          "headers": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
