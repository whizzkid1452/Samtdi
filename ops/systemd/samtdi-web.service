[Unit]
Description=Samtdi Next.js web
After=network-online.target samtdi-api.service
Wants=network-online.target

[Service]
User=samtdi
Group=samtdi
WorkingDirectory=/opt/samtdi/current/apps/web
Environment=NODE_ENV=production
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3100
Restart=on-failure
TimeoutStopSec=35
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
