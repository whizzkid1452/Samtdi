# Local test fixtures. Use injected secrets and HTTPS for deployments.
AYOTBI_DATABASE_URL=postgresql://samtdi:samtdi-local-only@127.0.0.1:56444/samtdi?sslmode=disable
AYOTBI_ORIGIN=http://127.0.0.1:3100
AYOTBI_OIDC_ISSUER=http://127.0.0.1:5556/dex
AYOTBI_OIDC_CLIENT_ID=samtdi-local
AYOTBI_OIDC_CLIENT_SECRET=samtdi-local-oidc-only
AYOTBI_BOOTSTRAP_EMAIL=owner@example.test
AYOTBI_ALLOW_LOOPBACK_HTTP=1
AYOTBI_S3_ENDPOINT=http://127.0.0.1:57070
AYOTBI_S3_BUCKET=samtdi-local
AYOTBI_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=samtdi-local
AWS_SECRET_ACCESS_KEY=samtdi-local-storage-only
AWS_DEFAULT_REGION=us-east-1
AWS_EC2_METADATA_DISABLED=true
